# Required: at least 32 random chars; part of the webhook URL path. Generate: openssl rand -hex 24
RELAY_SECRET=
# Google Chat → your space → Apps & integrations → Webhooks
GCHAT_DEPLOYMENTS=https://chat.googleapis.com/v1/spaces/XXXX/messages?key=XXXX&token=XXXX
# Optional: commit details on cards (required for the GitHub sink). Read-only token is enough.
COOLIFY_API_URL=http://coolify:8080
COOLIFY_API_TOKEN=
# Display time zone for cards
TZ=Asia/Karachi
LOG_LEVEL=info

# Phase 2 (GitHub Deployments) — only used when config.json enables github.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=          # PEM; literal \n sequences are accepted
# GITHUB_APP_PRIVATE_KEY_FILE=
# GITHUB_TOKEN=                    # alternative: fine-grained PAT, Deployments: read & write
